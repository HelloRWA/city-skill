{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HelloRWA/city-skill/schemas/source.schema.json",
  "title": "City Skill source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "kind", "materialId", "url", "locator", "excerpt", "verificationStatus", "checkedAt", "verifiedAt", "verifiedBy", "officialUrl", "license"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": { "enum": ["official-website", "official-document", "yearbook", "document", "map", "image", "other"] },
    "materialId": { "type": "string", "maxLength": 200 },
    "url": { "type": "string", "maxLength": 2048 },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "chapter"],
      "properties": {
        "page": { "type": "string", "maxLength": 100 },
        "chapter": { "type": "string", "maxLength": 200 }
      }
    },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "verificationStatus": { "enum": ["unverified", "verified", "stale"] },
    "checkedAt": { "type": "string", "format": "date-time" },
    "verifiedAt": { "type": "string" },
    "verifiedBy": { "type": "string" },
    "officialUrl": { "type": "string", "maxLength": 2048 },
    "license": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
  }
}
