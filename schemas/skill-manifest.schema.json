{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HelloRWA/city-skill/schemas/skill-manifest.schema.json",
  "title": "City Skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "description", "entityId", "scope", "mcp", "entry", "references", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "entityId": { "$ref": "#/$defs/id" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canAnswer", "mustHandoff"],
      "properties": {
        "canAnswer": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "mustHandoff": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferredServer", "readOnly", "externalServers"],
      "properties": {
        "preferredServer": { "type": "string", "minLength": 1 },
        "readOnly": { "const": true },
        "externalServers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "readOnly", "autoConnect", "requiresExplicitUserConsent", "credentials"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 8 },
              "readOnly": { "const": true },
              "autoConnect": { "const": false },
              "requiresExplicitUserConsent": { "const": true },
              "credentials": { "enum": ["none", "user-provided"] }
            }
          }
        }
      }
    },
    "entry": { "const": "SKILL.md" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "title", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["guide", "data", "reference", "itinerary"] }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireSources", "requireCheckedAt", "dynamicFields"],
      "properties": {
        "requireSources": { "const": true },
        "requireCheckedAt": { "const": true },
        "dynamicFields": {
          "type": "array",
          "items": { "enum": ["price", "openingHours", "reservation", "eventSchedule", "performanceSchedule", "merchantStatus", "campusAccess", "ferrySchedule"] },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
  }
}
